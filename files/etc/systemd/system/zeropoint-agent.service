[Unit]
Description=ZeroPoint Python Agent
After=network-online.target docker.service zeropoint-setup-storage.service
Wants=network-online.target
Requires=docker.service zeropoint-setup-storage.service

[Service]
Type=simple
WorkingDirectory=/var/lib/zeropoint
Environment="PATH=/opt/zeropoint-agent/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=-/etc/zeropoint-agent.env
ExecStartPre=/usr/local/bin/zeropoint-init-agent
ExecStart=/opt/zeropoint-agent/venv/bin/zeropoint-agent serve --host 0.0.0.0 --port 2370
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
