# The API and xDS endpoints bind on all interfaces and are intended only for a
# trusted LAN. Add a firewall or reverse-proxy authentication before exposure.
ZEROPOINT_MODE=live
ZEROPOINT_SEED_ROOTS=1
ZEROPOINT_ROOT_PATH=/var/lib/zeropoint
ZP_AGENT_STATE_ROOT=/var/lib/zeropoint/data/modules
ZP_MODULE_STORAGE=/var/lib/zeropoint/modules
ZEROPOINT_AGENT_PORT=2370
ZEROPOINT_XDS_PORT=18000
ZEROPOINT_MDNS_ADVERTISE=1
PYTHONUNBUFFERED=1
