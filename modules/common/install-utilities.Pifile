RUN apt-get update

# The generic cloud tarball can retain package metadata while omitting files
# that are normally restored on first cloud boot, so force reinstallation.
RUN bash -c 'DEBIAN_FRONTEND=noninteractive apt-get install --reinstall -y avahi-daemon ca-certificates curl dosfstools e2fsprogs fdisk git gnupg jq lshw nano netcat-openbsd parted pciutils python3 python3-pip python3-venv rsync sqlite3 udev util-linux'

# Set nano as the default editor.
RUN bash -c 'echo "export EDITOR=nano" >> /etc/profile.d/editor.sh'
RUN bash -c 'echo "export VISUAL=nano" >> /etc/profile.d/editor.sh'
